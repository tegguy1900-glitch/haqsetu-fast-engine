+def check_success(brick_name):
+    """Checks if the brick successfully appended GREEN to the progress file."""
+    if not os.path.exists(progress_file):
+        return False
+    with open(progress_file, 'r') as f:
+        content = f.read()
+    return f"{brick_name} GREEN" in content
