+
+for pass_num in range(1, MAX_PASSES + 1):
+    print(f"\n--- PASS {pass_num} of {MAX_PASSES} ---")
+    all_success = True
+    
+    for brick in BRICKS:
+        if brick['status'] == 'SUCCESS':
+            continue
+            
+        all_success = False
+        brick['attempts'] += 1
+        print(f"\n[Brick {brick['id']}: {brick['name']}] Attempt {brick['attempts']}...")
+        
+        # Run Aider
+        try:
+            # We pipe stdout/stderr to a log file to keep terminal clean
+            with open(f"brick_{brick['id']}_log.txt", "w") as log_file:
+                subprocess.run(
+                    AIDER_CMD + ["--message", brick['prompt']],
+                    stdout=log_file,
+                    stderr=subprocess.STDOUT,
+                    timeout=1800 # 30 minute timeout per brick
+                )
+        except subprocess.TimeoutExpired:
+            print(f"  -> TIMED OUT after 30 mins.")
+        except Exception as e:
+            print(f"  -> CRASHED: {e}")
+
+        # Check if it worked
+        if check_success(brick['name']):
+            print(f"  -> SUCCESS!")
+            brick['status'] = 'SUCCESS'
+        else:
+            print(f"  -> FAILED. Will retry in next pass.")
+            brick['status'] = 'FAILED'
+            
+        # Small cooldown to let RAM clear slightly
+        time.sleep(10)
+
+    if all_success:
+        print("\n=== ALL BRICKS SUCCESSFUL! BUILD COMPLETE. ===")
+        break
+else:
+    print("\n=== BUILD FINISHED. SOME BRICKS ARE STUCK. ===")
+    print("Stuck bricks:")
+    for brick in BRICKS:
+        if brick['status'] != 'SUCCESS':
+            print(f"  - Brick {brick['id']}: {brick['name']}")
+
+print("Check individual brick logs (e.g., brick_14_log.txt) for errors.")
+EOF

