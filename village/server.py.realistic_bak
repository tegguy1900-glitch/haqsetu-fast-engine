"""
HaqSetu v2.0 - F.A.S.T. Engine (restored stable build)
Pure stdlib HTTP server + SQLite. No frameworks, no MQTT, no FastAPI.
"""
import os, json, sqlite3, hashlib, time, traceback, re
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse

PORT = int(os.environ.get("PORT", os.environ.get("HAQ_VILLAGE_PORT", "8000")))
HOST = os.environ.get("HOST", "127.0.0.1")
DB_PATH = "data/haqsetu.db"
UPLOAD_DIR = "uploads"
REPORTS_DIR = "reports"
for d in (UPLOAD_DIR, REPORTS_DIR, "data"):
    os.makedirs(d, exist_ok=True)

HAS_OCR = False
HAS_BOT = False
try:
    from core.parser import parse_user_input
    try:
        from core.parser import parse_image_input
        HAS_OCR = True
    except ImportError:
        print("⚠️ OCR libs missing - image auto-fill disabled.")
    try:
        from core.bot_playwright import get_bot
        HAS_BOT = True
    except ImportError as e:
        print("⚠️ Bot module unavailable (%s) - auto-submit disabled." % e)
    from core.geoutil import calculate_distance, is_within_radius
    from core.nlp_engine import predict_intent
except ImportError as e:
    print("❌ CRITICAL IMPORT ERROR: %s" % e)
    raise SystemExit(1)

try:
    from core.sms_service import send_otp
    HAS_SMS = True
except ImportError:
    HAS_SMS = False
try:
    from core.pdf_gen import generate_sdm_report
    HAS_PDF = True
except ImportError:
    HAS_PDF = False

def get_db_conn():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    conn = get_db_conn(); c = conn.cursor()
    c.execute("""CREATE TABLE IF NOT EXISTS tickets_infra (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        description TEXT, photo_path TEXT,
        geo_lat REAL, geo_lon REAL,
        status TEXT DEFAULT 'open',
        fix_geo_lat REAL, fix_geo_lon REAL, otp_code TEXT,
        timestamp_created TIMESTAMP DEFAULT CURRENT_TIMESTAMP)""")
    c.execute("""CREATE TABLE IF NOT EXISTS applications_scheme (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        citizen_mobile_hash TEXT, scheme_name TEXT, parsed_data_json TEXT,
        bot_status TEXT, reg_id_generated TEXT, screenshot_path TEXT,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP)""")
    conn.commit(); conn.close()

def hash_mobile(m): return hashlib.sha256(str(m).encode()).hexdigest()[:16]
def generate_otp(): return str(int(time.time()) % 10000).zfill(4)

class HaqSetuHandler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *a): pass
    def _send_json(self, code, data):
        body = json.dumps(data).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
    def _read_body(self):
        n = int(self.headers.get("Content-Length", 0) or 0)
        raw = self.rfile.read(n) if n else b"{}"
        try: return json.loads(raw.decode("utf-8"))
        except Exception: return {}
    def _serve_file(self, path, mime):
        try:
            with open(path, "rb") as f: data = f.read()
            self.send_response(200)
            self.send_header("Content-Type", mime)
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
        except FileNotFoundError:
            self._send_json(404, {"error": "file not found: " + path})

    def do_GET(self):
        p = urlparse(self.path).path
        if p in ("/", "/index.html"):
            self._serve_file("web_demo/index.html", "text/html")
        elif p.startswith("/assets/") or p.endswith(".css") or p.endswith(".js"):
            fn = p.split("/")[-1]
            mime = "text/css" if fn.endswith(".css") else "application/javascript"
            self._serve_file("web_demo/" + fn, mime)
        elif p.startswith("/uploads/"):
            self._serve_file(UPLOAD_DIR + "/" + p.split("/")[-1], "image/jpeg")
        elif p.startswith("/reports/"):
            self._serve_file(REPORTS_DIR + "/" + p.split("/")[-1], "application/pdf")
        elif p == "/api/agenda":
            self.handle_get_agenda()
        elif p == "/health":
            self._send_json(200, {"status":"online","engine":"F.A.S.T.","ocr":HAS_OCR,"bot":HAS_BOT})
        else:
            self._send_json(404, {"error":"not found"})

    def do_POST(self):
        p = urlparse(self.path).path
        d = self._read_body()
        if p == "/api/voice/match": self.handle_voice_match(d)
        elif p == "/api/scheme/wizard": self.handle_wizard_step(d)
        elif p == "/api/scheme/execute": self.handle_execute_bot(d)
        elif p == "/api/infra/create": self.handle_infra_create(d)
        elif p == "/api/infra/fix": self.handle_infra_fix(d)
        elif p == "/api/infra/close": self.handle_infra_close(d)
        elif p == "/api/meeting/report": self.handle_generate_report(d)
        else: self._send_json(404, {"error":"endpoint not found"})

    def handle_voice_match(self, data):
        t = (data.get("text") or "").strip()
        if not t:
            self._send_json(400, {"error":"empty text"}); return
        try:
            r = predict_intent(t); intent = r["intent"]; conf = r["confidence"]
        except Exception as e:
            print("❌ NLP error:", e); intent = "UNKNOWN"; conf = 0.0
        schemes = []
        if intent == "MGNREGA": schemes.append({"id":"MGNREGA","name":"MGNREGA Job Card","can_apply":True})
        elif intent == "OLD_AGE_PENSION": schemes.append({"id":"OLD_AGE_PENSION","name":"Old Age Pension","can_apply":True})
        elif intent == "VIDHWA_PENSION": schemes.append({"id":"VIDHWA_PENSION","name":"Widow Pension","can_apply":True})
        elif intent == "INFRA_BROKEN":
            self._send_json(200, {"intent":"INFRA","message":"Infra issue detected","confidence":conf}); return
        else: schemes.append({"id":"NONE","name":"No match","can_apply":False})
        self._send_json(200, {"schemes":schemes,"ai_confidence":conf,"detected_intent":intent})

    def handle_wizard_step(self, data):
        step = int(data.get("step", 1) or 1)
        text = data.get("text","")
        cur = data.get("accumulated_data",{}) or {}
        doc = data.get("doc_path")
        if HAS_OCR and step == 1 and doc and os.path.exists(doc):
            try:
                ocr = parse_image_input(doc) or {}
                for k,v in ocr.items():
                    if v: cur[k]=v
                self._send_json(200, {"status":"auto_filled","message":"Details extracted from ID","accumulated_data":cur}); return
            except Exception as e:
                print("OCR runtime error:", e)
        if text:
            try:
                parsed = parse_user_input(text) or {}
                for k,v in parsed.items():
                    if v: cur[k]=v
            except Exception as e:
                print("parse error:", e)
        self._send_json(200, {"accumulated_data":cur})

    def handle_execute_bot(self, data):
        sid = data.get("scheme_id"); ud = data.get("user_data"); doc = data.get("doc_path")
        if not HAS_BOT:
            self._send_json(503, {"status":"failed","error":"Bot module not installed (playwright)."}); return
        try:
            bot = get_bot()
            res = bot.execute_registration(sid, ud, doc)
        except Exception as e:
            traceback.print_exc()
            self._send_json(500, {"status":"failed","error":str(e)}); return
        if res.get("status") == "success":
            conn = get_db_conn(); c = conn.cursor()
            c.execute("""INSERT INTO applications_scheme
                (citizen_mobile_hash, scheme_name, parsed_data_json, bot_status, reg_id_generated, screenshot_path)
                VALUES (?,?,?,?,?,?)""",
                (hash_mobile((ud or {}).get("mobile","unknown")), sid, json.dumps(ud), "success",
                 res.get("registration_id"), res.get("screenshot_path")))
            conn.commit(); conn.close()
        self._send_json(200 if res.get("status")=="success" else 500, res)

    def handle_infra_create(self, data):
        desc = data.get("description"); lat=float(data.get("lat",0)); lon=float(data.get("lon",0))
        photo = data.get("photo")
        fn = "ticket_%d.jpg" % int(time.time()); fp = os.path.join(UPLOAD_DIR, fn)
        if photo:
            import base64
            try:
                img = base64.b64decode(photo.split(",")[1])
                with open(fp,"wb") as f: f.write(img)
            except Exception as e:
                print("photo save error:", e); fp = ""
        else:
            fp = ""
        conn = get_db_conn(); c = conn.cursor()
        c.execute("""INSERT INTO tickets_infra (description, photo_path, geo_lat, geo_lon, status)
                     VALUES (?,?,?,?, 'open')""", (desc, fp, lat, lon))
        tid = c.lastrowid; conn.commit(); conn.close()
        self._send_json(200, {"ticket_id": tid, "status":"created"})

    def handle_infra_fix(self, data):
        tid = data.get("ticket_id"); nlat=float(data.get("new_lat",0)); nlon=float(data.get("new_lon",0))
        mob = data.get("citizen_mobile", "+919876543210")
        conn = get_db_conn(); c = conn.cursor()
        c.execute("SELECT geo_lat, geo_lon FROM tickets_infra WHERE id=?", (tid,))
        row = c.fetchone()
        if not row:
            conn.close(); self._send_json(404, {"error":"ticket not found"}); return
        ok, dist = is_within_radius(row["geo_lat"], row["geo_lon"], nlat, nlon, radius_meters=50)
        if not ok:
            conn.close(); self._send_json(400, {"error":"GEO_MISMATCH distance=%.1fm" % dist}); return
        otp = generate_otp()
        c.execute("""UPDATE tickets_infra SET status='fixed_pending_otp', fix_geo_lat=?, fix_geo_lon=?, otp_code=? WHERE id=?""",
                  (nlat, nlon, otp, tid))
        conn.commit(); conn.close()
        sms = "SIMULATED"
        if HAS_SMS:
            try:
                if send_otp(mob, otp): sms = "SENT_REAL_SMS"
            except Exception as e:
                sms = "SMS_ERROR: %s" % str(e)[:40]
        self._send_json(200, {"message": "Fix verified. SMS: %s" % sms, "otp_preview": otp})

    def handle_infra_close(self, data):
        tid = data.get("ticket_id"); entered = data.get("otp")
        conn = get_db_conn(); c = conn.cursor()
        c.execute("SELECT otp_code FROM tickets_infra WHERE id=?", (tid,))
        row = c.fetchone()
        if not row or row["otp_code"] != entered:
            conn.close(); self._send_json(400, {"error":"INVALID_OTP"}); return
        c.execute("UPDATE tickets_infra SET status='closed' WHERE id=?", (tid,))
        conn.commit(); conn.close()
        self._send_json(200, {"message":"Ticket closed."})

    def handle_get_agenda(self):
        conn = get_db_conn(); c = conn.cursor()
        c.execute("SELECT * FROM tickets_infra ORDER BY timestamp_created DESC")
        tickets = [dict(r) for r in c.fetchall()]
        c.execute("SELECT * FROM applications_scheme ORDER BY created_at DESC")
        apps = [dict(r) for r in c.fetchall()]
        conn.close()
        self._send_json(200, {"tickets": tickets, "applications": apps})

    def handle_generate_report(self, data):
        if not HAS_PDF:
            self._send_json(500, {"error":"PDF library (fpdf) missing"}); return
        try:
            fp = generate_sdm_report()
            self._send_json(200, {"status":"success","message":"Report generated","download_url":"/reports/"+os.path.basename(fp)})
        except Exception as e:
            traceback.print_exc(); self._send_json(500, {"error": str(e)})

if __name__ == "__main__":
    init_db()
    srv = ThreadingHTTPServer((HOST, PORT), HaqSetuHandler)
    print("🏛️  HAQSETU F.A.S.T. ENGINE (v2 stable) RUNNING")
    print("   🌐 URL : http://%s:%d" % (HOST, PORT))
    print("   🗄️  DB  : %s" % DB_PATH)
    print("   🤖 Bot: %s | 📱 SMS: %s | 📄 PDF: %s | 👁️ OCR: %s" % (
        "Ready" if HAS_BOT else "OFF", "Active" if HAS_SMS else "Simulated",
        "Ready" if HAS_PDF else "OFF", "On" if HAS_OCR else "Off"))
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\n👋 shutting down"); srv.shutdown()
