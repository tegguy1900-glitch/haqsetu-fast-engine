<!-- HaqSetu v2 frontend (regenerated, single script block) -->
<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HaqSetu | F.A.S.T. Engine</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Inter,system-ui,Arial,sans-serif;background:#0f172a;color:#e2e8f0}
header{display:flex;align-items:center;gap:14px;padding:14px 22px;background:#111827;border-bottom:1px solid #1e293b;flex-wrap:wrap}
header h1{font-size:18px;margin:0;color:#60a5fa}
nav{display:flex;gap:8px;margin-left:auto;flex-wrap:wrap}
nav button{background:#1e293b;color:#cbd5e1;border:1px solid #334155;border-radius:8px;padding:8px 14px;cursor:pointer;font-size:14px}
nav button.active{background:#2563eb;color:#fff;border-color:#2563eb}
main{padding:22px;max-width:1000px;margin:0 auto}
.view{display:none}.view.active{display:block}
.card{background:#1e293b;border:1px solid #334155;border-radius:12px;padding:18px;margin-bottom:16px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px}
.stat{text-align:center}.stat .n{font-size:30px;font-weight:700}.stat .l{color:#94a3b8;font-size:13px}
label{display:block;font-size:13px;color:#cbd5e1;margin:12px 0 6px}
input,select,textarea{width:100%;background:#0f172a;color:#e2e8f0;border:1px solid #475569;border-radius:8px;padding:10px;font-size:14px;font-family:inherit}
textarea{min-height:80px;resize:vertical}
.btn{background:#2563eb;color:#fff;border:0;border-radius:8px;padding:11px 16px;font-size:14px;font-weight:600;cursor:pointer;margin-top:12px}
.btn.ghost{background:#334155}.btn.green{background:#16a34a}.btn.red{background:#dc2626}
.btn:disabled{opacity:.5;cursor:not-allowed}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.tkt{border-left:3px solid #f59e0b;padding:10px 12px;background:#0f172a;border-radius:8px;margin-bottom:8px}
.tkt.closed{border-left-color:#22c55e;opacity:.7}
.badge{font-size:11px;padding:2px 8px;border-radius:999px;background:#334155}
.badge.open{background:#7c2d12;color:#fdba74}.badge.fixed_pending_otp{background:#713f12;color:#fde68a}.badge.closed{background:#14532d;color:#bbf7d0}
#toast-container{position:fixed;bottom:18px;right:18px;z-index:3000;display:flex;flex-direction:column;gap:8px;max-width:340px;pointer-events:none}
.toast{background:#020617;border:1px solid #334155;border-left:4px solid #2563eb;border-radius:8px;padding:10px 12px;font-size:13px;box-shadow:0 6px 18px rgba(0,0,0,.4)}
.toast.err{border-left-color:#ef4444}.toast.ok{border-left-color:#22c55e}
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:2000;align-items:center;justify-content:center;padding:16px}
.modal.open{display:flex}
.modal .box{background:#1e293b;border:1px solid #334155;border-radius:14px;padding:20px;width:100%;max-width:480px;max-height:90vh;overflow:auto}
.steps{display:flex;gap:6px;margin-bottom:14px}
.steps span{flex:1;height:4px;background:#334155;border-radius:2px}.steps span.on{background:#2563eb}
.muted{color:#94a3b8;font-size:13px}
a{color:#60a5fa}
</style></head>
<body>
<header>
<h1>HaqSetu <span class="muted" style="font-size:12px">F.A.S.T. Engine v2</span></h1>
<button class="btn ghost" style="margin:0;padding:6px 10px;font-size:12px" onclick="pingHealth()">Test Backend</button>
<nav>
<button id="nav-citizen" class="active" onclick="switchView('citizen')">Citizen</button>
<button id="nav-je" onclick="switchView('je')">JE / Field</button>
<button id="nav-sarpanch" onclick="switchView('sarpanch')">Sarpanch</button>
</nav>
</header>
<main>
<section id="view-citizen" class="view active">
<div class="card">
<h2 style="margin-top:0">Report a Grievance or Find a Scheme</h2>
<p class="muted">Speak or type in plain language (Hindi/English mix ok). The AI routes it to a scheme or files an infra ticket.</p>
<div class="row"><button id="mic-btn" class="btn ghost" onclick="toggleListening()">Speak</button><span id="live-transcript" class="muted">not listening</span></div>
<label>Or type</label>
<textarea id="manual-input" placeholder="e.g. mera handpump toot gaya / widow pension chahiye"></textarea>
<button class="btn" onclick="processInput()">Analyze Request</button>
<div id="intake-results" style="margin-top:14px"></div>
</div>
<div class="card">
<h3 style="margin-top:0">File an Infrastructure Ticket</h3>
<label>Description</label>
<textarea id="infra-desc" placeholder="e.g. drain near temple blocked, water stagnating"></textarea>
<label>Photo (optional)</label>
<input type="file" id="infra-photo" accept="image/*">
<button class="btn green" onclick="submitInfraTicket()">Submit Ticket (sends GPS + photo)</button>
<div id="infra-out" class="muted" style="margin-top:10px"></div>
</div>
</section>
<section id="view-je" class="view">
<div class="card"><h2 style="margin-top:0">Field Engineer Queue</h2>
<button class="btn ghost" onclick="loadJETickets()">Refresh</button>
<div id="je-tickets-list" style="margin-top:12px"></div>
</div>
</section>
<section id="view-sarpanch" class="view">
<div class="grid" style="margin-bottom:16px">
<div class="card stat"><div class="n" id="stat-open-count" style="color:#f59e0b">0</div><div class="l">Open Tickets</div></div>
<div class="card stat"><div class="n" id="stat-resolved-count" style="color:#22c55e">0</div><div class="l">Resolved</div></div>
<div class="card stat"><div class="n" id="stat-pending-apps" style="color:#60a5fa">0</div><div class="l">Scheme Applications</div></div>
</div>
<div class="card"><h3 style="margin-top:0">Panchayat Meeting</h3>
<div class="row">
<button class="btn ghost" onclick="startMeetingSim()">Simulate Meeting Record</button>
<button class="btn ghost" onclick="clearMeetingLog()">Clear</button>
<button class="btn" onclick="generateSDMReport()">Generate SDM Report (prints Merkle hash)</button>
</div>
<pre id="meeting-transcript" class="muted" style="white-space:pre-wrap;margin-top:12px;min-height:40px"></pre>
<div id="post-meeting-actions"></div>
</div>
<div class="card"><h3 style="margin-top:0">Full Agenda</h3>
<button class="btn ghost" onclick="loadAgenda()">Load</button>
<div id="agenda-items-list" style="margin-top:12px"></div>
<canvas id="agendaChart" height="120" style="margin-top:14px"></canvas>
</div>
</section>
</main>
<div id="wizard-modal" class="modal"><div class="box">
<h3 id="wizard-scheme-name" style="margin-top:0">Apply</h3>
<div class="steps"><span id="ws1" class="on"></span><span id="ws2"></span></div>
<div id="wizard-form-area"></div>
<div class="row" style="margin-top:14px">
<button class="btn ghost" onclick="wizBack()">Back</button>
<button class="btn" id="wizard-next-btn" onclick="wizNext()">Next</button>
<button class="btn red" onclick="closeWizard()">Cancel</button>
</div>
</div></div>
<div id="fix-modal" class="modal"><div class="box">
<h3 style="margin-top:0">Mark Ticket Fixed</h3>
<p class="muted">Capture GPS at the repair site. System verifies within 50 m of the original complaint before issuing an OTP.</p>
<input type="hidden" id="modal-ticket-id">
<div class="row"><input id="fix-lat" placeholder="lat"><input id="fix-lon" placeholder="lon"></div>
<button class="btn ghost" style="margin-top:8px" onclick="geoFillFix()">Use my location</button>
<label>Citizen mobile (for OTP)</label>
<input id="fix-mobile" value="+919876543210">
<button class="btn green" onclick="submitFix()">Verify and Send OTP</button>
<div id="fix-otp-area" style="display:none;margin-top:12px">
<label>Enter OTP shown to citizen</label><input id="fix-otp" placeholder="4 digits">
<button class="btn" onclick="submitClose()">Close Ticket</button>
</div>
<button class="btn red" style="margin-top:12px" onclick="closeFixModal()">Cancel</button>
</div></div>
<div id="toast-container"></div>
<script>
var API="";
var SCHEMES={"MGNREGA":"MGNREGA Job Card","OLD_AGE_PENSION":"Old Age Pension","VIDHWA_PENSION":"Widow Pension"};
var wiz={schemeId:"",schemeName:"",step:1,data:{}};
var recog=null,listening=false,_chart=null;
function esc(s){return String(s==null?"":s).replace(/[&<>"]/g,function(c){return({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"})[c];});}
function toast(msg,type){var c=document.getElementById("toast-container");var d=document.createElement("div");d.className="toast "+(type||"");d.textContent=msg;c.appendChild(d);setTimeout(function(){d.remove();},6000);}
window.onerror=function(m,s,l){toast("JS ERROR: "+m+" (line "+l+")","err");};
function api(path,body){var o={method:body?"POST":"GET",headers:{"Content-Type":"application/json"}};if(body){o.body=JSON.stringify(body);}return fetch(API+path,o).then(function(r){return r.json().then(function(j){return {ok:r.status<400,status:r.status,data:j};});});}
function switchView(v){["citizen","je","sarpanch"].forEach(function(x){document.getElementById("view-"+x).classList.toggle("active",x===v);document.getElementById("nav-"+x).classList.toggle("active",x===v);});if(v==="je"){loadJETickets();}if(v==="sarpanch"){loadAgenda();}}
function pingHealth(){api("/health").then(function(r){toast("Backend /health -> "+r.status+(r.data&&r.data.engine?" ("+r.data.engine+")":""),r.ok?"ok":"err");}).catch(function(e){toast("Backend unreachable: "+e.message,"err");});}
function toggleListening(){var SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){toast("Speech API not in this browser - use the text box","err");document.getElementById("manual-input").focus();return;}if(listening){if(recog){recog.stop();}return;}recog=new SR();recog.lang="hi-IN";recog.interimResults=true;recog.continuous=false;recog.onresult=function(e){var t="";for(var i=0;i<e.results.length;i++){t+=e.results[i][0].transcript;}document.getElementById("live-transcript").textContent=t;document.getElementById("manual-input").value=t;};recog.onend=function(){listening=false;document.getElementById("mic-btn").textContent="Speak";};recog.onerror=function(e){toast("Mic error: "+e.error,"err");};listening=true;document.getElementById("mic-btn").textContent="Stop";recog.start();}
function fillInfraFromManual(){switchView("citizen");document.getElementById("infra-desc").value=document.getElementById("manual-input").value;toast("Copied into ticket box - add GPS/photo and submit","ok");}
function processInput(){var t=document.getElementById("manual-input").value.trim();if(!t){toast("Type or speak something first","err");return;}var box=document.getElementById("intake-results");box.innerHTML='<span class="muted">Analyzing...</span>';api("/api/voice/match",{text:t}).then(function(r){var d=r.data||{};if(d.intent==="INFRA"){box.innerHTML='<div class="card" style="border-left:3px solid #f59e0b"><b>Infra issue detected</b> ('+Math.round((d.confidence||0)*100)+'%)<br><span class="muted">'+esc(d.message||"")+'</span><br><button class="btn green" onclick="fillInfraFromManual()">File this as a ticket</button></div>';return;}var s=d.schemes||[];var h='<p class="muted">Detected: <b>'+esc(d.detected_intent)+'</b> confidence '+Math.round((d.ai_confidence||0)*100)+'%</p><div class="grid">';s.forEach(function(x){h+='<div class="card"><b>'+esc(x.name)+'</b><p class="muted">'+(x.can_apply?"Eligible to apply":"No direct match")+'</p>'+(x.can_apply?'<button class="btn" onclick="startWizard(\''+esc(x.id)+'\')">Apply Now</button>':'')+'</div>';});box.innerHTML=h+'</div>';}).catch(function(e){box.innerHTML="";toast("Intake failed: "+e.message,"err");});}
function startWizard(id){wiz={schemeId:id,schemeName:SCHEMES[id]||id,step:1,data:{}};document.getElementById("wizard-scheme-name").textContent=wiz.schemeName;renderWiz();document.getElementById("wizard-modal").classList.add("open");}
function closeWizard(){document.getElementById("wizard-modal").classList.remove("open");}
function setSteps(){document.getElementById("ws1").className=wiz.step>=1?"on":"";document.getElementById("ws2").className=wiz.step>=2?"on":"";document.getElementById("wizard-next-btn").textContent=wiz.step===2?"Submit to Portal":"Next";}
function renderWiz(){setSteps();var a=document.getElementById("wizard-form-area");if(wiz.step===1){a.innerHTML='<label>Full Name</label><input id="w-name" value="'+esc(wiz.data.name||"")+'"><label>Father / Husband</label><input id="w-father" value="'+esc(wiz.data.father||"")+'"><label>Mobile</label><input id="w-mobile" value="'+esc(wiz.data.mobile||"")+'"><label>Aadhaar (last 4)</label><input id="w-aadhaar" maxlength="4" value="'+esc(wiz.data.aadhaar||"")+'">';}else{a.innerHTML='<div class="card" style="background:#0f172a"><b>Review</b><table style="width:100%;font-size:14px"><tr><td class="muted">Name</td><td>'+esc(wiz.data.name)+'</td></tr><tr><td class="muted">Father/Husband</td><td>'+esc(wiz.data.father)+'</td></tr><tr><td class="muted">Mobile</td><td>'+esc(wiz.data.mobile)+'</td></tr><tr><td class="muted">Aadhaar</td><td>XXXX-XXXX-'+esc(wiz.data.aadhaar)+'</td></tr><tr><td class="muted">Scheme</td><td>'+esc(wiz.schemeName)+'</td></tr></table></div><p class="muted">The Vision Bot fills the govt form, captures proof, and seals the record in the Merkle ledger.</p>';}}
function wizBack(){if(wiz.step>1){wiz.step--;renderWiz();}}
function wizNext(){if(wiz.step===1){["name","father","mobile","aadhaar"].forEach(function(k){var el=document.getElementById("w-"+k);if(el){wiz.data[k]=el.value.trim();}});if(!wiz.data.name||!wiz.data.mobile){toast("Name and mobile required","err");return;}wiz.step=2;renderWiz();return;}submitBot();}
function submitBot(){var btn=document.getElementById("wizard-next-btn");btn.disabled=true;btn.textContent="Bot running...";api("/api/scheme/execute",{scheme_id:wiz.schemeId,user_data:wiz.data}).then(function(r){btn.disabled=false;setSteps();var d=r.data||{};if(d.status==="success"){document.getElementById("wizard-form-area").innerHTML='<div class="card" style="border-left:3px solid #22c55e"><b>Registered</b><p>Reg ID: <b>'+esc(d.registration_id)+'</b></p>'+(d.screenshot_path?'<a href="/uploads/'+esc(String(d.screenshot_path).split("/").pop())+'" target="_blank">View proof screenshot</a>':'')+'</div>';toast("Scheme application approved","ok");loadAgenda();}else{document.getElementById("wizard-form-area").innerHTML='<div class="card" style="border-left:3px solid #ef4444"><b>Bot could not complete</b><p class="muted">'+esc(d.error||d.message||"see terminal")+'</p></div>';toast("Execute returned non-success","err");}}).catch(function(e){btn.disabled=false;setSteps();toast("Execute failed: "+e.message,"err");});}
function fileToDataURL(inp,cb){var f=inp.files&&inp.files[0];if(!f){cb(null);return;}var rd=new FileReader();rd.onload=function(){cb(rd.result);};rd.readAsDataURL(f);}
function geo(cb){if(navigator.geolocation){navigator.geolocation.getCurrentPosition(function(p){cb(p.coords.latitude,p.coords.longitude);},function(){cb(28.9069,77.7453);},{enableHighAccuracy:true,timeout:4000});}else{cb(28.9069,77.7453);}}
function submitInfraTicket(){var desc=document.getElementById("infra-desc").value.trim();if(!desc){toast("Describe the issue","err");return;}var out=document.getElementById("infra-out");out.textContent="Fetching GPS + encoding photo...";fileToDataURL(document.getElementById("infra-photo"),function(photo){geo(function(lat,lon){api("/api/infra/create",{description:desc,lat:lat,lon:lon,photo:photo}).then(function(r){if(r.ok&&r.data.ticket_id){out.textContent="Ticket #"+r.data.ticket_id+" created (geo "+lat.toFixed(4)+", "+lon.toFixed(4)+").";toast("Ticket #"+r.data.ticket_id+" filed","ok");document.getElementById("infra-desc").value="";loadJETickets();}else{out.textContent="Failed: "+JSON.stringify(r.data);toast("Create failed","err");}}).catch(function(e){out.textContent="";toast("Create error: "+e.message,"err");});});});}
function loadJETickets(){var list=document.getElementById("je-tickets-list");list.innerHTML='<span class="muted">Loading...</span>';api("/api/agenda").then(function(r){var ts=(r.data&&r.data.tickets)||[];var act=ts.filter(function(t){return t.status!=="closed";});if(!act.length){list.innerHTML='<p class="muted">No active tickets</p>';return;}list.innerHTML=act.map(function(t){return '<div class="tkt"><div class="row" style="justify-content:space-between"><b>#'+t.id+' '+esc(String(t.description||"").slice(0,60))+'</b><span class="badge '+esc(t.status)+'">'+esc(t.status)+'</span></div><div class="muted" style="margin:4px 0">geo '+Number(t.geo_lat).toFixed(4)+', '+Number(t.geo_lon).toFixed(4)+'</div><button class="btn green" onclick="openFixModal('+t.id+','+Number(t.geo_lat)+','+Number(t.geo_lon)+')">Mark Fixed</button></div>';}).join("");}).catch(function(e){list.innerHTML="";toast("Agenda load failed: "+e.message,"err");});}
function openFixModal(id,lat,lon){document.getElementById("modal-ticket-id").value=id;document.getElementById("fix-lat").value=lat;document.getElementById("fix-lon").value=lon;document.getElementById("fix-otp-area").style.display="none";document.getElementById("fix-modal").classList.add("open");}
function closeFixModal(){document.getElementById("fix-modal").classList.remove("open");}
function geoFillFix(){geo(function(lat,lon){document.getElementById("fix-lat").value=lat;document.getElementById("fix-lon").value=lon;});}
function submitFix(){var id=document.getElementById("modal-ticket-id").value;api("/api/infra/fix",{ticket_id:Number(id),new_lat:parseFloat(document.getElementById("fix-lat").value)||0,new_lon:parseFloat(document.getElementById("fix-lon").value)||0,citizen_mobile:document.getElementById("fix-mobile").value}).then(function(r){if(r.ok){document.getElementById("fix-otp-area").style.display="block";toast(r.data.message||"OTP issued","ok");if(r.data.otp_preview){document.getElementById("fix-otp").placeholder="demo OTP: "+r.data.otp_preview;}}else{toast(r.data.error||"Geo mismatch / not found","err");}}).catch(function(e){toast("Fix error: "+e.message,"err");});}
function submitClose(){var id=document.getElementById("modal-ticket-id").value;api("/api/infra/close",{ticket_id:Number(id),otp:document.getElementById("fix-otp").value.trim()}).then(function(r){if(r.ok){toast("Ticket closed","ok");closeFixModal();loadJETickets();}else{toast(r.data.error||"Invalid OTP","err");}}).catch(function(e){toast("Close error: "+e.message,"err");});}
function loadAgenda(){api("/api/agenda").then(function(r){var d=r.data||{};var ts=d.tickets||[],ap=d.applications||[];var open=ts.filter(function(t){return t.status!=="closed";}).length;var res=ts.filter(function(t){return t.status==="closed";}).length;document.getElementById("stat-open-count").textContent=open;document.getElementById("stat-resolved-count").textContent=res;document.getElementById("stat-pending-apps").textContent=ap.length;var h="<h4>Tickets</h4>"+ts.map(function(t){return '<div class="tkt '+(t.status==="closed"?"closed":"")+'">#'+t.id+' '+esc(String(t.description||"").slice(0,50))+' <span class="badge '+esc(t.status)+'">'+esc(t.status)+'</span></div>';}).join("")+"<h4>Applications</h4>"+(ap.length?ap.map(function(a){return '<div class="tkt">'+esc(a.scheme_name)+' '+esc(a.reg_id_generated||"-")+' <span class="badge closed">'+esc(a.bot_status)+'</span></div>';}).join(""):'<p class="muted">none yet</p>');document.getElementById("agenda-items-list").innerHTML=h;drawChart(open,res,ap.length);}).catch(function(e){toast("Agenda failed: "+e.message,"err");});}
function drawChart(o,rr,a){if(typeof Chart==="undefined"){return;}var ctx=document.getElementById("agendaChart");if(_chart){_chart.destroy();}_chart=new Chart(ctx,{type:"doughnut",data:{labels:["Open","Resolved","Applications"],datasets:[{data:[o,rr,a],backgroundColor:["#f59e0b","#22c55e","#60a5fa"]}]},options:{plugins:{legend:{labels:{color:"#cbd5e1"}}}}});}
function startMeetingSim(){var t=document.getElementById("meeting-transcript");var lines=["[10:02] Sarpanch: Meeting called to order.","[10:03] Reviewing open infra tickets.","[10:05] JE reports drain cleared at ward 4.","[10:06] Pension applications approved by bot.","[10:07] Motion: seal today's ledger. Carried."];t.textContent="";var i=0;var iv=setInterval(function(){if(i>=lines.length){clearInterval(iv);document.getElementById("post-meeting-actions").innerHTML='<button class="btn" onclick="generateSDMReport()">Generate SDM Report from this meeting</button>';return;}t.textContent+=lines[i]+"\n";i++;},700);}
function clearMeetingLog(){document.getElementById("meeting-transcript").textContent="";document.getElementById("post-meeting-actions").innerHTML="";}
function generateSDMReport(){api("/api/meeting/report",{}).then(function(r){if(r.ok&&r.data.download_url){toast("Report generated","ok");document.getElementById("post-meeting-actions").innerHTML='<a class="btn" href="'+esc(r.data.download_url)+'" target="_blank" style="display:inline-block;text-decoration:none">Download PDF ('+esc(r.data.message||"")+')</a>';loadAgenda();}else{toast(r.data.error||"Report failed (PDF lib?)","err");}}).catch(function(e){toast("Report error: "+e.message,"err");});}
window.addEventListener("DOMContentLoaded",function(){switchView("citizen");});
</script>
</body></html>
